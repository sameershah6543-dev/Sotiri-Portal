# Copy this to .env.local for local dev, and set the same values in
# Vercel → Project Settings → Environment Variables for production.

# Postgres connection string (Vercel Postgres / Neon give you this).
DATABASE_URL=postgres://user:password@host:5432/dbname

# NextAuth session encryption — generate with: npx auth secret
AUTH_SECRET=

# First team (edit) login, used once by `npm run db:seed-admin`.
INITIAL_ADMIN_EMAIL=you@example.com
INITIAL_ADMIN_PASSWORD=change-me-now

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/refresh. Any random string; must match what's set in Vercel.
CRON_SECRET=

# The real MCC platform API credentials (brief §4) — get these from the
# platform's own dashboard. Until both are set, /api/refresh safely no-ops.
MCC_API_BASE_URL=
MCC_API_KEY=
